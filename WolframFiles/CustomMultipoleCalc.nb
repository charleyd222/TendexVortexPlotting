Cell[CellGroupData[{

Cell["Spin Weighted Spherical Harmonics", "Section",
 CellChangeTimes->{{3.978465481830954*^9, 
  3.9784654920053864`*^9}},ExpressionUUID->"d1e4c8fb-04d5-4ad8-ab4d-\
4ac7a0839cf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Y", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], 
   "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "m"], 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "m"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "m"}], ")"}], "!"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "+", "1"}], ")"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "s"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "s"}], ")"}], "!"}], "4", "\[Pi]"}]]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Sin", "[", 
         FractionBox["\[Theta]", "2"], "]"}], ")"}], 
       RowBox[{"2", "l"}]], 
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"r", "=", "0"}], 
        RowBox[{"l", "-", "s"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"l", "-", "s"}], ",", "r"}], "]"}], 
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"l", "+", "s"}], ",", 
           RowBox[{"r", "+", "s", "-", "m"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"l", "-", "r", "-", "s"}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"Cot", "[", 
            FractionBox["\[Theta]", "2"], "]"}], ")"}], 
          RowBox[{
           RowBox[{"2", "r"}], "+", "s", "-", "m"}]]}], ")"}]}]}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Phi]", "\[Element]", "Reals"}], ",", 
        RowBox[{"\[Theta]", "\[Element]", "Reals"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.978465662025259*^9, 3.9784656783772497`*^9}, {
   3.978465767960869*^9, 3.978465776789146*^9}, 3.978985128411476*^9, 
   3.978985167561324*^9, 3.9789852715783052`*^9, 3.978985399413507*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"c65e4117-e696-4868-b26c-c1c704b7ff44"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"TE2a", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  " ", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "+", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TE2b", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "-", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TE2Test", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TE2a", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      RowBox[{"TE2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
     "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TE2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      " ", 
      RowBox[{"-", 
       RowBox[{"TE2a", "[", 
        RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}], 
     "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SMom", "[", 
   RowBox[{
   "t_", ",", "r_", ",", "M_", ",", "\[CapitalOmega]_", ",", "\[Omega]_", ",",
     "l_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "M"}], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", " ", 
        RowBox[{"(", 
         RowBox[{"t", "-", "r"}], ")"}]}], "+", "\[Omega]"}], 
      ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"TE2STT", "[", 
    RowBox[{
    "1", ",", "r", ",", "\[Theta]", ",", "\[Phi]", ",", "2", ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"SMom", "[", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"Pi", "/", "2"}], ",", " ", "0"}], "]"}], 
    RowBox[{"TE2Test", "[", 
