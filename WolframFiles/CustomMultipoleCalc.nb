Cell[BoxData[{
 RowBox[{
  RowBox[{"QuadropoleSum", "[", 
   RowBox[{"\[Omega]_", ",", "C_"}], "]"}], ":=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Eigenvalues", "[", 
