Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"Y", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], 
   "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "m"], 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "m"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "m"}], ")"}], "!"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "+", "1"}], ")"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "s"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "s"}], ")"}], "!"}], "4", "\[Pi]"}]]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Sin", "[", 
         FractionBox["\[Theta]", "2"], "]"}], ")"}], 
       RowBox[{"2", "l"}]], 
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"r", "=", "0"}], 
        RowBox[{"l", "-", "s"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"l", "-", "s"}], ",", "r"}], "]"}], 
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"l", "+", "s"}], ",", 
           RowBox[{"r", "+", "s", "-", "m"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"l", "-", "r", "-", "s"}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"Cot", "[", 
            FractionBox["\[Theta]", "2"], "]"}], ")"}], 
          RowBox[{
           RowBox[{"2", "r"}], "+", "s", "-", "m"}]]}], ")"}]}]}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Phi]", "\[Element]", "Reals"}], ",", 
        RowBox[{"\[Theta]", "\[Element]", "Reals"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.978465662025259*^9, 3.9784656783772497`*^9}, {
   3.978465767960869*^9, 3.978465776789146*^9}, 3.978985128411476*^9, 
   3.978985167561324*^9, 3.9789852715783052`*^9, 3.978985399413507*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"49fdb252-f240-462b-aaed-932d51766d79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"TE2a", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  " ", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "+", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
