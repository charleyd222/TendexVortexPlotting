Cell[BoxData[{
 RowBox[{
  RowBox[{"TestEigenM", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"Max", "[", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{"EMas", "[", 
         RowBox[{"\[Theta]", ",", "\[Phi]", ",", "w"}], "]"}], "]"}], "]"}], 
      ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], "\[Element]", "Reals"}]}],
      "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TestEigenC", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"Max", "[", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{"ECur", "[", 
         RowBox[{"\[Theta]", ",", "\[Phi]", ",", "w"}], "]"}], "]"}], "]"}], 
      ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], "\[Element]", "Reals"}]}],
      "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TestEigenS", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"Max", "[", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"EMas", "[", 
          RowBox[{"\[Theta]", ",", "\[Phi]", ",", "0"}], "]"}], "+", 
         RowBox[{"ECur", "[", 
          RowBox[{"\[Theta]", ",", "\[Phi]", ",", "w"}], "]"}]}], "]"}], 
       "]"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], "\[Element]", "Reals"}]}],
      "]"}], "]"}], "]"}]}]}], "Input",
