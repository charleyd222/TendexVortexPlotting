   FractionBox["1", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "-", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TE2b", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "-", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TB2b", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    SuperscriptBox["2", "1.5"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], " ", "+", " ", 
     RowBox[{"Y", "[", 
      RowBox[{"2", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TE2", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TE2a", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      RowBox[{"TE2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
     "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TE2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      " ", 
      RowBox[{"-", 
       RowBox[{"TE2a", "[", 
        RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}], 
     "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TB2", "[", 
   RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TB2a", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      RowBox[{"TB2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
     "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TB2b", "[", 
       RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      " ", 
      RowBox[{"-", 
       RowBox[{"TB2a", "[", 
        RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}], 
     "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mom", "[", 
   RowBox[{
   "t_", ",", "r_", ",", "M_", ",", "\[CapitalOmega]_", ",", "\[Omega]_", ",",
     "l_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "M"}], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", " ", 
        RowBox[{"(", 
         RowBox[{"t", "-", "r"}], ")"}]}], "+", "\[Omega]"}], 
      ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EMas", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "w_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"mom", "[", 
     RowBox[{
     "0", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ", "w", ",", 
      " ", "0"}], "]"}], 
    RowBox[{"TE2", "[", 
     RowBox[{"2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ECur", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "w_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"mom", "[", 
     RowBox[{
     "0", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ", "w", ",", 
      " ", "0"}], "]"}], 
    RowBox[{"TB2", "[", 
