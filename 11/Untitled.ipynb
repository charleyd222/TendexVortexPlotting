   "source": [
    "theta = np.linspace(0, 2*np.pi, 3, endpoint=False)\n",
    "r = np.linspace(0, 1, 500)\n",
    "\n",
    "for th in theta:\n",
    "    u = r**3 * np.cos(3*th)\n",
    "    v = r**3 * np.sin(3*th)\n",
    "    plt.plot(u, v)\n"
   ]
